      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   pm.collectionVariables.set(\"test_email\", `candra${Date.now()}@test.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   pm.test(\"Status 201 - register berhasil\", function () {\r\n     pm.response.to.have.status(201);\r\n   });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "   {\r\n     \"name\": \"Candra Test\",\r\n     \"email\": \"{{test_email}}\",\r\n     \"password\": \"rahasia123\"\r\n   }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
